# 全站共用的 D2 樣式。scripts/render-d2.mjs 會把這段接在每張圖的原始碼前面，
# 所以任何一篇文章的 {{< d2 >}} 都自動套到，不必逐張設定。
#
# 這個檔案的「內容」也算進圖的雜湊（腳本與 shortcode 兩邊都會讀），
# 所以改了配色之後，所有圖會自動重新渲染，不會沿用舊快取。
#
# 配色原則跟站上一致：暖灰階為主，橘色只當強調用，不當底色。
vars: {
  d2-config: {
    theme-overrides: {
      N1: "#1c1917"
      N2: "#44403c"
      N3: "#78716c"
      N4: "#a8a29e"
      N5: "#d6d3d1"
      N6: "#f5f5f4"
      N7: "#ffffff"
      B1: "#44403c"
      B2: "#57534e"
      B3: "#ffffff"
      B4: "#f5f5f4"
      B5: "#e7e5e4"
      B6: "#d6d3d1"
      AA2: "#c2410c"
      AA4: "#fed7aa"
      AA5: "#ffedd5"
      AB4: "#e7e5e4"
      AB5: "#f5f5f4"
    }
    dark-theme-overrides: {
      # N1..N4 都可能被拿來畫文字（例如類別圖的 +/- 修飾符用的是 N4）。
      # 第一版把深色的 N4 設成 #78716c，在 #292524 的形狀底上只有 3.16，
      # 所以這裡整條中間灰階往亮的方向移。
      N1: "#e7e5e4"
      N2: "#d6d3d1"
      N3: "#c4bfba"
      N4: "#a8a29e"
      N5: "#57534e"
      N6: "#44403c"
      N7: "#292524"
      B1: "#a8a29e"
      # B2 不只是外框色 —— 類別圖的 +/- 存取修飾符也是用它畫的（class 是 fill-B2）。
      # 原本 #78716c 落在 #292524 的卡片底上只有 3.16，要夠亮才讀得到。
      B2: "#b0aaa4"
      B3: "#292524"
      B4: "#1f1c1a"
      B5: "#44403c"
      B6: "#57534e"
      AA2: "#fb923c"
      AA4: "#7c2d12"
      AA5: "#431407"
      AB4: "#44403c"
      AB5: "#292524"
    }
  }
}

# 字級跟內文對齊（內文是 18px）。D2 預設 16px、容器標題 28px，
# 圖再被縮小之後標籤只剩 12–13px，跟旁邊的內文擺在一起明顯小一截。
#
# 這幾行不能合併成一條 `**.style.font-size`——
# 目前這版 D2（v0.7.0）不吃遞迴 glob `**`，會回 `"style" needs a value`。
# 只好分成：頂層節點、第二層節點、頂層連線、巢狀連線。
*.style.font-size: 18
*.*.style.font-size: 18
(* -> *)[*].style.font-size: 18
(*.* -> *.*)[*].style.font-size: 18
# `->` 以外的連線型別要各自寫一條，否則會留在預設的 16px。
(* <-> *)[*].style.font-size: 18
(* -- *)[*].style.font-size: 18
(* <- *)[*].style.font-size: 18
